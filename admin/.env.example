# ── SeeWater admin website ─────────────────────────────────────────────────
# Copy to .env.local. These are PUBLIC Firebase web-app settings (safe to ship
# to the browser); access is enforced by Firebase Auth + security rules.
#
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development with the Firebase Emulator Suite (npm run emulators in website/server):
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# URL of the SeeWater Express API (server-side only; used by the /api proxy)
API_URL=http://localhost:4000
