# Firebase Emulator Suite. Use with: npm run dev:emulator
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-seewater.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-seewater-default-rtdb
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-seewater
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-seewater.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=true
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
API_URL=http://localhost:4000
