# ── SeeWater API configuration ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env or service-account keys.

PORT=4000
NODE_ENV=development

# Long random string used to sign homeowner (mobile app) tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin session length in hours (Firebase session cookie, 1–336)
SESSION_HOURS=8
DEVICE_ONLINE_WINDOW_MINUTES=5
ACTIVATION_CODE_DAYS=30
# Raw sensor readings get expireAt = recordedAt + N days (enable the Firestore TTL policy)
READING_RETENTION_DAYS=90

# ── Firebase ────────────────────────────────────────────────────────────────
DB_DRIVER=firestore
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Service account (Firebase console → Project settings → Service accounts →
# Generate new private key). Either paste the three fields…
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# …or point to the downloaded JSON file (keep it out of version control):
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Local development with the Firebase Emulator Suite instead of the real project:
# FIREBASE_PROJECT_ID=demo-seewater
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Homeowner app: verification emails (leave empty in development to print codes to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SeeWater <no-reply@your-domain>"
HOMEOWNER_SESSION_DAYS=30

# Expo push notifications (optional access token if push security is enabled for your Expo project)
EXPO_ACCESS_TOKEN=
